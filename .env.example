# ==========================================
# Botswana Economic Pulse — Environment Config
# Copy this file to ".env" and fill in values.
# NEVER commit the actual .env file.
# ==========================================

# ---- Database ----
# Local development (SQLite) — works instantly:
DATABASE_URL=sqlite:///data/pulse.db

# Production (Supabase PostgreSQL) — uncomment and use later:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# ---- Optional: WhatsApp (Phase 4) ----
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=

# ---- Optional: Paid data sources ----
# EXCHANGE_API_KEY=
